{
  "name": "telangana-water-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/verify_static.mjs && vite build",
    "data:terrain": "node scripts/cache_terrain.mjs",
    "data:context": "node scripts/extend_terrain_context.mjs",
    "data:gauges": "node scripts/update_gauges.mjs",
    "test:static": "playwright test tests/static.spec.js --workers=1 --output=/tmp/telangana-static-ui-results",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test tests/sidebar.spec.js --workers=1 --output=/tmp/telangana-ui-test-results",
    "test:terrain": "playwright test tests/terrain.spec.js --workers=1 --output=/tmp/telangana-terrain-ui-results",
    "test:browser": "playwright test --workers=1",
    "docs:screenshots": "node scripts/capture_screenshots.mjs",
    "docs:check": "node scripts/verify_docs.mjs"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "geotiff": "^3.0.5",
    "vite": "^7.3.1"
  },
  "description": "An educational atlas of Telangana terrain, water paths and irrigation systems.",
  "license": "MIT",
  "author": "Sai Kiran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krngd2/telangana-water-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/krngd2/telangana-water-atlas/issues"
  },
  "homepage": "https://github.com/krngd2/telangana-water-atlas#readme",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
