{
  "name": "telangana-water-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/verify_static.mjs && vite build",
    "data:terrain": "node scripts/cache_terrain.mjs",
    "data:context": "node scripts/extend_terrain_context.mjs",
    "data:gauges": "node scripts/update_gauges.mjs",
    "test:static": "playwright test tests/static.spec.js --workers=1 --output=/tmp/telangana-static-ui-results",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test tests/sidebar.spec.js --workers=1 --output=/tmp/telangana-ui-test-results",
    "test:terrain": "playwright test tests/terrain.spec.js --workers=1 --output=/tmp/telangana-terrain-ui-results"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "geotiff": "^3.0.5",
    "vite": "^7.3.1"
  }
}
